# Copy this file to `.env` (same folder) and paste your key.
# .env is listed in .gitignore, so your key never goes to GitHub.

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Optional: pick a specific Gemini model (default: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# Optional alternative: Anthropic Claude
# ANTHROPIC_API_KEY=
